<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AITokenUsage.UI.Controls"
                    xmlns:res="clr-namespace:AITokenUsage.Resources">
    <!--
        Settings window styles (v1.1 spec §4.2). Merged into Application.Resources (App.xaml) so the brushes below are only
        fallbacks: the settings window sets ThemeMode, which puts the Fluent dictionary into the window's own resources, and
        DynamicResource lookups find those first. If a Fluent key is ever missing, the system colour here is used instead of
        an unset (invisible) brush. Nothing outside the settings window references these keys.
    -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="{x:Static SystemColors.ControlDarkDarkColor}" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefaultBrush" Color="{x:Static SystemColors.ControlDarkDarkColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{x:Static SystemColors.ControlLightColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="{x:Static SystemColors.ControlLightColor}" />
    <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{x:Static SystemColors.InfoColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{x:Static SystemColors.ControlTextColor}" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{x:Static SystemColors.ControlColor}" />
    <!-- Keyboard focus only (FocusVisualStyle is not shown for mouse clicks). -->
    <Style x:Key="SettingsFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="6" BorderThickness="2" SnapsToDevicePixels="True"
                            BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        CheckBox as a Windows 11 toggle switch: 40×20 track, 14 px knob that moves 20 px to the right when on, and the
        On/Off text on the right. Keeps CheckBox semantics (Space toggles, UI Automation Toggle pattern).
    -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="28" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1"
                                Background="Transparent" BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                        <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Fill="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                        <TextBlock x:Name="StateText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" Text="{x:Static res:UiStrings.ToggleOff}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            <Setter TargetName="Knob" Property="Margin" Value="23,0,0,0" />
                            <Setter TargetName="StateText" Property="Text" Value="{x:Static res:UiStrings.ToggleOn}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:SettingsCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:SettingsCard">
                    <Border CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderText" Text="{TemplateBinding Header}" FontSize="14" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Foreground="{TemplateBinding Foreground}" />
                                <TextBlock x:Name="DescriptionText" Text="{TemplateBinding Description}" FontSize="12" Margin="0,2,0,0"
                                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="DescriptionText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="DescriptionText" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:StatusBadge">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:StatusBadge">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot" Width="8" Height="8" VerticalAlignment="Center" Fill="#8A8A8A" />
                        <TextBlock x:Name="Label" Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Kind" Value="Connected">
                            <Setter TargetName="Dot" Property="Fill" Value="#2EA043" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Warning">
                            <Setter TargetName="Dot" Property="Fill" Value="#F5A524" />
                        </Trigger>
                        <Trigger Property="Kind" Value="Error">
                            <Setter TargetName="Dot" Property="Fill" Value="#F04438" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Left navigation item: 36 high, rounded selection background, 3 px accent bar on the left, Segoe Fluent Icons glyph
        and label. The item data is any object with Glyph and Label properties (SettingsNavItem).
    -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,1,4,1" />
        <Setter Property="Padding" Value="14,0,12,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:IconGlyph Width="16" VerticalAlignment="Center" FontSize="16" TextAlignment="Center"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="{Binding Glyph}" />
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Text="{Binding Label}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bg" CornerRadius="4" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Subtle 32×32 icon toggle (provider card expand chevron): no background until hovered or pressed, so it does not
        take the Fluent accent fill when checked. Keeps ToggleButton semantics (Space/Enter, UI Automation Toggle pattern).
    -->
    <Style x:Key="SubtleIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" CornerRadius="4" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded card of the provider list (same look as SettingsCard, free-form content). -->
    <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- InfoBar-like notice (General page: "restart to apply"). -->
    <Style x:Key="InfoBarBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
</ResourceDictionary>
