<UserControl x:Class="AITokenUsage.UI.SystemBesidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             IsHitTestVisible="False">
    <!-- 64 DIP = WidgetMetrics.SystemGapDip (8, divider included) + SystemColumnDip (56: label 24 + value 32). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="56" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Divider" Grid.Column="0" Width="1" Margin="4,6,3,6" HorizontalAlignment="Left" />

        <Grid Grid.Column="1" Height="32" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="CpuLabel" Grid.Row="0" Grid.Column="0" FontSize="10.5" VerticalAlignment="Center" />
            <TextBlock x:Name="CpuValue" Grid.Row="0" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                       TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock x:Name="RamLabel" Grid.Row="1" Grid.Column="0" FontSize="10.5" VerticalAlignment="Center" />
            <TextBlock x:Name="RamValue" Grid.Row="1" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                       TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
