<UserControl x:Class="AITokenUsage.UI.Settings.ProviderCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AITokenUsage.UI.Controls"
             xmlns:res="clr-namespace:AITokenUsage.Resources"
             Focusable="False"
             IsTabStop="False">
    <Border Style="{StaticResource SettingsCardBorderStyle}">
        <StackPanel>
            <!-- Header: glyph, name over badge + status sentence, "show on widget" switch, expand chevron. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="GlyphHost" Grid.Column="0" Width="16" Height="16" Margin="0,0,12,0"
                                VerticalAlignment="Center" Focusable="False" IsTabStop="False" />

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NameText" Grid.Row="0" Grid.ColumnSpan="2" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <controls:StatusBadge x:Name="Badge" Grid.Row="1" Grid.Column="0" Margin="0,2,6,0" />
                    <TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>

                <StackPanel Grid.Column="2" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{x:Static res:UiStrings.ProviderShowOnWidget}" />
                    <CheckBox x:Name="EnabledBox" Style="{StaticResource ToggleSwitchStyle}" />
                </StackPanel>

                <ToggleButton x:Name="ExpandButton" Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                              Style="{StaticResource SubtleIconToggleStyle}">
                    <controls:IconGlyph x:Name="ChevronGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </ToggleButton>
            </Grid>

            <!-- Copilot: the GitHub device-flow sign-in panel, above the guide. -->
            <ContentControl x:Name="ExtraHost" Margin="28,12,0,0" Focusable="False" IsTabStop="False" Visibility="Collapsed" />

            <!-- How to connect: always shown (even collapsed) while there is something to guide. -->
            <Border x:Name="GuideHost" Margin="28,12,0,0" Visibility="Collapsed" />

            <!-- Expanded options: line drop-downs (label above), then reorder buttons. -->
            <Grid x:Name="OptionsPanel" Margin="28,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" FontSize="12" Text="{x:Static res:UiStrings.ProviderLine1Label}" />
                <ComboBox x:Name="Line1Box" Grid.Row="1" Grid.Column="0" DisplayMemberPath="Label" SelectedValuePath="Key"
                          IsSynchronizedWithCurrentItem="False" />
                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" FontSize="12" Text="{x:Static res:UiStrings.ProviderLine2Label}" />
                <ComboBox x:Name="Line2Box" Grid.Row="1" Grid.Column="2" DisplayMemberPath="Label" SelectedValuePath="Key"
                          IsSynchronizedWithCurrentItem="False" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Orientation="Horizontal">
                    <Button x:Name="UpButton" MinWidth="0" Padding="12,4,12,4" Content="{x:Static res:UiStrings.ProviderMoveUpButton}" />
                    <Button x:Name="DownButton" MinWidth="0" Padding="12,4,12,4" Margin="8,0,0,0"
                            Content="{x:Static res:UiStrings.ProviderMoveDownButton}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
