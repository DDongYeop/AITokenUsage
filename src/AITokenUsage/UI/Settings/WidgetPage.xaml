<local:SettingsPage x:Class="AITokenUsage.UI.Settings.WidgetPage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:AITokenUsage.UI"
                    xmlns:local="clr-namespace:AITokenUsage.UI.Settings"
                    xmlns:controls="clr-namespace:AITokenUsage.UI.Controls"
                    xmlns:res="clr-namespace:AITokenUsage.Resources">
    <StackPanel>
        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetMonitorHeader}">
            <ComboBox x:Name="MonitorBox" Width="260" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetMonitorHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetPlacementHeader}">
            <ComboBox x:Name="PlacementBox" Width="260" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetPlacementHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetValueModeHeader}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="UsedRadio" GroupName="ValueMode" MinWidth="0" Margin="0,0,16,0"
                             Content="{x:Static res:UiStrings.ValueModeUsed}"
                             AutomationProperties.Name="{x:Static res:UiStrings.ValueModeUsed}" />
                <RadioButton x:Name="RemainingRadio" GroupName="ValueMode" MinWidth="0"
                             Content="{x:Static res:UiStrings.ValueModeRemaining}"
                             AutomationProperties.Name="{x:Static res:UiStrings.ValueModeRemaining}" />
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetShowResetTimeHeader}"
                               Description="{x:Static res:UiStrings.WidgetShowResetTimeDescription}">
            <CheckBox x:Name="ShowResetTimeBox" Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetShowResetTimeHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetRefreshOnHoverHeader}">
            <CheckBox x:Name="RefreshOnHoverBox" Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetRefreshOnHoverHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetShowDetailCardHeader}"
                               Description="{x:Static res:UiStrings.WidgetShowDetailCardDescription}">
            <CheckBox x:Name="ShowDetailCardBox" Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetShowDetailCardHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetSystemMonitorHeader}">
            <ComboBox x:Name="SystemMonitorBox" Width="260" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetSystemMonitorHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetProviderIconStyleHeader}"
                               Description="{x:Static res:UiStrings.ProviderIconStyleDescription}">
            <ComboBox x:Name="IconStyleBox" Width="260" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetProviderIconStyleHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="CustomIconCard" Visibility="Collapsed"
                               Header="{x:Static res:UiStrings.CustomIconHeader}"
                               Description="{x:Static res:UiStrings.CustomIconFormats}">
            <StackPanel Width="260">
                <ComboBox x:Name="CustomProviderBox" DisplayMemberPath="Label"
                          AutomationProperties.Name="{x:Static res:UiStrings.CustomIconHeader}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <ui:ProviderIcon x:Name="CustomIconPreview" Width="16" Height="16" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                    <Button x:Name="ChooseIconButton" Content="{x:Static res:UiStrings.CustomIconChoose}" />
                    <Button x:Name="RemoveIconButton" Margin="6,0,0,0" Content="{x:Static res:UiStrings.CustomIconRemove}" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetTextColorHeader}">
            <ComboBox x:Name="TextColorBox" Width="260" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetTextColorHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetFontHeader}">
            <ComboBox x:Name="FontBox" Width="260" DisplayMemberPath="Label" TextSearch.TextPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetFontHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetTextWeightHeader}">
            <ComboBox x:Name="TextWeightBox" Width="260" DisplayMemberPath="Label"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetTextWeightHeader}" />
        </controls:SettingsCard>

        <controls:SettingsCard Header="{x:Static res:UiStrings.WidgetSmoothTextHeader}"
                               Description="{x:Static res:UiStrings.WidgetSmoothTextDescription}">
            <CheckBox x:Name="SmoothWidgetTextBox" Style="{StaticResource ToggleSwitchStyle}"
                      AutomationProperties.Name="{x:Static res:UiStrings.WidgetSmoothTextHeader}" />
        </controls:SettingsCard>
    </StackPanel>
</local:SettingsPage>
