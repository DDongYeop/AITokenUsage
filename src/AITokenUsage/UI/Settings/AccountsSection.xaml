<UserControl x:Class="AITokenUsage.UI.Settings.AccountsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AITokenUsage.UI.Controls"
             xmlns:res="clr-namespace:AITokenUsage.Resources"
             Focusable="False"
             IsTabStop="False">
    <!-- "Add account" (multi-account spec §5): below the provider cards. The page runs the sign-in; this shows its state. -->
    <Border Style="{StaticResource SettingsCardBorderStyle}" Margin="0,12,0,4">
        <StackPanel>
            <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Text="{x:Static res:UiStrings.AccountsHeader}" />
            <TextBlock Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{x:Static res:UiStrings.AccountsDescription}" />

            <WrapPanel Margin="0,12,0,0" Orientation="Horizontal">
                <Button x:Name="AddClaudeButton" MinWidth="0" Padding="12,4,12,4" IsEnabled="False"
                        Content="{x:Static res:UiStrings.AccountAddClaudeButton}" />
                <Button x:Name="AddCodexButton" MinWidth="0" Padding="12,4,12,4" Margin="8,0,0,0" IsEnabled="False"
                        Content="{x:Static res:UiStrings.AccountAddCodexButton}" />
            </WrapPanel>

            <TextBlock x:Name="ClaudeMissingText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:UiStrings.AccountClaudeMissing}" />
            <TextBlock x:Name="CodexMissingText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static res:UiStrings.AccountCodexMissing}" />

            <!-- Waiting for the terminal sign-in. -->
            <Grid x:Name="ProgressPanel" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ProgressText" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                           Text="{x:Static res:UiStrings.AccountAddProgress}" />
                <Button x:Name="CancelButton" Grid.Column="1" Margin="12,0,0,0" MinWidth="0" Padding="12,4,12,4"
                        VerticalAlignment="Center" Content="{x:Static res:UiStrings.AccountCancelButton}" />
            </Grid>

            <!-- Added: the panel appears after a restart. -->
            <Border x:Name="AddedNotice" Style="{StaticResource InfoBarBorderStyle}" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:IconGlyph Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="16"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;"
                                        Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                               Text="{x:Static res:UiStrings.AccountAddedNotice}" />
                    <Button x:Name="RestartButton" Grid.Column="2" Margin="12,0,0,0" Padding="12,4,12,4" MinWidth="0"
                            Content="{x:Static res:UiStrings.GeneralRestartNowButton}"
                            AutomationProperties.Name="{x:Static res:UiStrings.GeneralRestartNowButton}" />
                </Grid>
            </Border>

            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </Border>
</UserControl>
