<Window x:Class="AITokenUsage.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:AITokenUsage.Resources"
        Title="{x:Static res:UiStrings.SettingsTitle}"
        ThemeMode="System"
        Width="760"
        Height="540"
        MinWidth="640"
        MinHeight="460"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="NavList" Grid.Column="0" Width="200" Margin="0,8,0,8" Padding="0"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{x:Static res:UiStrings.SettingsNavigationName}" />

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Grid.Row="0" Margin="24,14,24,12" FontSize="20" FontWeight="SemiBold" />
            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ContentControl x:Name="PageHost" Margin="24,0,24,24" Focusable="False" IsTabStop="False" />
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
