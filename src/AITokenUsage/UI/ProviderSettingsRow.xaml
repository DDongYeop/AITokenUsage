<UserControl x:Class="AITokenUsage.UI.ProviderSettingsRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CheckBox x:Name="EnabledBox" Grid.Column="0" MinWidth="0" VerticalAlignment="Center" ToolTip="위젯에 표시" />
        <ContentControl x:Name="GlyphHost" Grid.Column="1" Width="14" Height="14" Margin="2,0,6,0"
                        VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
        <TextBlock x:Name="NameText" Grid.Column="2" Width="62" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" Grid.Column="3" Margin="0,0,6,0" FontSize="12" Opacity="0.75"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="UpButton" Content="▲" Width="30" Height="28" MinWidth="0" Padding="0" ToolTip="위로" />
            <Button x:Name="DownButton" Content="▼" Width="30" Height="28" MinWidth="0" Padding="0" Margin="4,0,0,0" ToolTip="아래로" />
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="1줄" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="Line1Box" Width="150" DisplayMemberPath="Label" SelectedValuePath="Key"
                      IsSynchronizedWithCurrentItem="False" />
            <TextBlock Text="2줄" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox x:Name="Line2Box" Width="150" DisplayMemberPath="Label" SelectedValuePath="Key"
                      IsSynchronizedWithCurrentItem="False" />
        </StackPanel>

        <ContentControl x:Name="ExtraHost" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                        Focusable="False" IsTabStop="False" Visibility="Collapsed" />
    </Grid>
</UserControl>
