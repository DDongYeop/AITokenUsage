<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless host for the macOS menu bar app (mac/AITokenUsageMac). Runs the Core providers and polling and writes the
    panels as JSON lines on stdout; reads commands on stdin. Cross-platform, but only the Mac app uses it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AITokenUsage.Agent</RootNamespace>
    <AssemblyName>aitokenusage-agent</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AITokenUsage.Core\AITokenUsage.Core.csproj" />
  </ItemGroup>

</Project>
