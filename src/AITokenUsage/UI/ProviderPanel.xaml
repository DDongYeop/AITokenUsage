<UserControl x:Class="AITokenUsage.UI.ProviderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             IsHitTestVisible="False">
    <Grid Margin="3,0,3,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="66" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Path x:Name="GlyphPath" Width="14" Height="14" VerticalAlignment="Center" />
                <TextBlock x:Name="NameText" Margin="4,0,0,0" MaxWidth="42" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StaleMark" Margin="1,0,0,0" Text="·" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="DotsPanel" Orientation="Horizontal" Margin="18,4,0,0" Height="5" Visibility="Collapsed" />
        </StackPanel>

        <Grid x:Name="RowsGrid" Grid.Column="1" Height="32" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="16" />
                <RowDefinition Height="16" />
            </Grid.RowDefinitions>

            <Grid x:Name="Row1" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Row1Label" Grid.Column="0" FontSize="10.5" VerticalAlignment="Center" />
                <Border x:Name="Row1Track" Grid.Column="1" Height="4" CornerRadius="2" VerticalAlignment="Center">
                    <Border x:Name="Row1Fill" Height="4" Width="0" CornerRadius="2" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="Row1Value" Grid.Column="3" MinWidth="32" FontSize="11.5" FontWeight="SemiBold"
                           TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock x:Name="Row1Text" Grid.Column="1" Grid.ColumnSpan="3" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </Grid>

            <Grid x:Name="Row2" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Row2Label" Grid.Column="0" FontSize="10.5" VerticalAlignment="Center" />
                <Border x:Name="Row2Track" Grid.Column="1" Height="4" CornerRadius="2" VerticalAlignment="Center">
                    <Border x:Name="Row2Fill" Height="4" Width="0" CornerRadius="2" HorizontalAlignment="Left" />
                </Border>
                <TextBlock x:Name="Row2Value" Grid.Column="3" MinWidth="32" FontSize="11.5" FontWeight="SemiBold"
                           TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                <TextBlock x:Name="Row2Text" Grid.Column="1" Grid.ColumnSpan="3" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.RowSpan="2" FontSize="11" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
