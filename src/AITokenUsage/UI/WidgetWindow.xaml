<Window x:Class="AITokenUsage.UI.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AITokenUsage.UI"
        xmlns:res="clr-namespace:AITokenUsage.Resources"
        Title="{x:Static res:UiStrings.WidgetWindowTitle}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        Topmost="False"
        UseLayoutRounding="True"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Height="40">
    <!-- #01000000: alpha 1 keeps the whole widget hit-testable (alpha 0 pixels pass clicks to the taskbar). -->
    <Border x:Name="Root"
            Background="#01000000"
            Height="40"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="Stage" Grid.Column="0" ClipToBounds="True">
                <ui:ProviderPanel x:Name="PanelA" />
                <ui:ProviderPanel x:Name="PanelB" Visibility="Hidden" Opacity="0" />
            </Grid>

            <!-- AlwaysBeside: fixed PC column outside the transition stage (Collapsed in the other modes). -->
            <ui:SystemBesidePanel x:Name="SystemColumn" Grid.Column="1" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
