<UserControl x:Class="AITokenUsage.UI.CopilotSignInPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:AITokenUsage.Resources">
    <StackPanel Margin="0,8,0,0">
        <StackPanel x:Name="SignedOutPanel" Orientation="Horizontal">
            <Button x:Name="SignInButton" Content="{x:Static res:UiStrings.CopilotSignInButton}" MinWidth="0" Padding="12,4,12,4" />
        </StackPanel>

        <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
            <TextBlock x:Name="ProgressText" FontSize="12" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="UserCodeText" MinWidth="110" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="CopyButton" Content="{x:Static res:UiStrings.CopilotCopyButton}" MinWidth="0" Padding="10,4,10,4" Margin="10,0,0,0" />
                <Button x:Name="OpenButton" Content="{x:Static res:UiStrings.CopilotOpenBrowserButton}" MinWidth="0" Padding="10,4,10,4" Margin="6,0,0,0" />
                <Button x:Name="CancelButton" Content="{x:Static res:UiStrings.CopilotCancelButton}" MinWidth="0" Padding="10,4,10,4" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="SignedInPanel" Orientation="Horizontal" Visibility="Collapsed">
            <TextBlock x:Name="LoginText" VerticalAlignment="Center" />
            <Button x:Name="SignOutButton" Content="{x:Static res:UiStrings.CopilotSignOutButton}" MinWidth="0" Padding="10,4,10,4" Margin="10,0,0,0" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Margin="0,4,0,0" FontSize="12" Foreground="#F04438" TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <TextBlock Margin="0,4,0,0" FontSize="11" Opacity="0.65" Text="{x:Static res:UiStrings.CopilotUnofficialApiNotice}" />
    </StackPanel>
</UserControl>
